<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>GEBCO Bathymetry Relief Map</title>

  <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>

  <style>
    html, body {
      height: 100%;
      width: 100%;
      margin: 0;
      background: black;
      color: white;
      font-family: Arial, sans-serif;
      overflow: hidden;
    }

    .page {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      padding: 10px;
      gap: 8px;
    }

    .header {
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .title {
      font-size: 18px;
      font-weight: bold;
    }

    .controls {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    button {
      background: white;
      color: black;
      border: none;
      padding: 7px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
    }

    button:hover {
      background: #e6e6e6;
    }

    #map {
      flex: 1;
      width: 100%;
      min-height: 0;
      border: 1px solid #222;
      border-radius: 6px;
      overflow: hidden;
    }

    .status {
      font-size: 12px;
      color: #ccc;
    }
  </style>
</head>

<body>

  <div class="page">

    <div class="header">
      <div>
        <div class="title">GEBCO 2025 Bathymetry - Area of Interest</div>
        <div class="status" id="status">Loading gebco_subset.json...</div>
      </div>

      <div class="controls">
        <button onclick="plot2D()">2D Relief</button>
        <button onclick="plot3D()">3D Surface</button>
      </div>
    </div>

    <div id="map"></div>

  </div>

  <script>
    let bathyData = null;

    const leaseLon = [
      -117.816670,
      -116.066667,
      -116.066667,
      -117.816670,
      -117.816670
    ];

    const leaseLat = [
      11.08333,
      11.08333,
      9.89500,
      9.89500,
      11.08333
    ];

    async function loadData() {
      try {
        const response = await fetch("gebco_subset.json");

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        bathyData = await response.json();

        document.getElementById("status").textContent =
          "Loaded gebco_subset.json";

        plot2D();
      } catch (error) {
        console.error("Error loading GEBCO JSON:", error);

        document.getElementById("status").textContent =
          "Error loading gebco_subset.json. Check file name, hosting path, and browser console.";
      }
    }

    function getZRange(z) {
      let zMin = Infinity;
      let zMax = -Infinity;

      for (let i = 0; i < z.length; i++) {
        for (let j = 0; j < z[i].length; j++) {
          const value = z[i][j];

          if (Number.isFinite(value)) {
            zMin = Math.min(zMin, value);
            zMax = Math.max(zMax, value);
          }
        }
      }

      return { zMin, zMax };
    }

    function plot2D() {
      if (!bathyData) return;

      const { lon, lat, z } = bathyData;
      const { zMin, zMax } = getZRange(z);

      const bathymetry = {
        type: "contour",
        x: lon,
        y: lat,
        z: z,
        colorscale: "Jet",
        zmin: zMin,
        zmax: zMax,
        contours: {
          coloring: "heatmap",
          showlines: false
        },
        colorbar: {
          title: {
            text: "Elevation (m)",
            font: { color: "white" }
          },
          tickfont: { color: "white" }
        },
        hovertemplate:
          "Lon: %{x:.5f}<br>" +
          "Lat: %{y:.5f}<br>" +
          "Elev: %{z:.1f} m<extra></extra>",
        name: "GEBCO Elevation"
      };

      const leaseBoundary = {
        type: "scatter",
        mode: "lines",
        x: leaseLon,
        y: leaseLat,
        line: {
          color: "red",
          width: 3
        },
        name: "Lease Boundary",
        hovertemplate:
          "Lease Boundary<br>" +
          "Lon: %{x:.5f}<br>" +
          "Lat: %{y:.5f}<extra></extra>"
      };

      const layout = {
        title: {
          text: "GEBCO 2025 Bathymetry - Area of Interest",
          font: { color: "white", size: 16 }
        },
        paper_bgcolor: "black",
        plot_bgcolor: "black",
        font: { color: "white" },
        margin: {
          l: 70,
          r: 30,
          t: 50,
          b: 60
        },
        xaxis: {
          title: "Longitude",
          showgrid: true,
          gridcolor: "#444",
          zeroline: false,
          showline: true,
          linecolor: "white",
          tickcolor: "white",
          scaleanchor: "y"
        },
        yaxis: {
          title: "Latitude",
          showgrid: true,
          gridcolor: "#444",
          zeroline: false,
          showline: true,
          linecolor: "white",
          tickcolor: "white"
        },
        legend: {
          bgcolor: "rgba(0,0,0,0.5)",
          font: { color: "white" }
        }
      };

      Plotly.newPlot("map", [bathymetry, leaseBoundary], layout, {
        responsive: true,
        displaylogo: false,
        scrollZoom: true
      });
    }

<script>
  function plot3D() {
    if (!bathyData) return;

    const { lon, lat, z } = bathyData;

    /*
      Plotly 3D surfaces look wrong if x/y are degrees and z is meters.
      Convert lon/lat to local kilometers for realistic terrain geometry.
    */
    const lon0 = lon.reduce((a, b) => a + b, 0) / lon.length;
    const lat0 = lat.reduce((a, b) => a + b, 0) / lat.length;

    const kmPerDegLat = 111.32;
    const kmPerDegLon = 111.32 * Math.cos(lat0 * Math.PI / 180);

    const xKm = lon.map(value => (value - lon0) * kmPerDegLon);
    const yKm = lat.map(value => (value - lat0) * kmPerDegLat);

    /*
      Convert elevation from meters to kilometers, then exaggerate.
      Increase verticalExaggeration if you want stronger relief.
    */
    const verticalExaggeration = 8;

    const zKmExag = z.map(row =>
      row.map(value => {
        if (value === null || value === undefined || !Number.isFinite(value)) {
          return null;
        }
        return (value / 1000) * verticalExaggeration;
      })
    );

    const surface = {
      type: "surface",
      x: xKm,
      y: yKm,
      z: zKmExag,

      surfacecolor: z,
      colorscale: [
        [0.00, "rgb(5, 10, 80)"],
        [0.20, "rgb(20, 60, 160)"],
        [0.40, "rgb(40, 130, 200)"],
        [0.55, "rgb(120, 190, 170)"],
        [0.70, "rgb(210, 200, 120)"],
        [0.85, "rgb(150, 110, 70)"],
        [1.00, "rgb(250, 250, 250)"]
      ],

      colorbar: {
        title: {
          text: "Elevation (m)",
          font: { color: "white" }
        },
        tickfont: { color: "white" }
      },

      contours: {
        z: {
          show: true,
          usecolormap: true,
          highlightcolor: "white",
          project: { z: true }
        }
      },

      lighting: {
        ambient: 0.35,
        diffuse: 0.85,
        specular: 0.15,
        roughness: 0.65,
        fresnel: 0.2
      },

      lightposition: {
        x: 100,
        y: 200,
        z: 1000
      },

      customdata: z,

      hovertemplate:
        "X: %{x:.2f} km<br>" +
        "Y: %{y:.2f} km<br>" +
        "Elevation: %{customdata:.1f} m<br>" +
        "<extra></extra>",

      name: "GEBCO Bathymetry"
    };

    /*
      Lease boundary converted to the same local km coordinate system.
      Put it slightly above z = 0 so it is visible.
    */
    const leaseXKm = leaseLon.map(value => (value - lon0) * kmPerDegLon);
    const leaseYKm = leaseLat.map(value => (value - lat0) * kmPerDegLat);
    const leaseZKm = leaseLon.map(() => 0.05);

    const leaseBoundary3D = {
      type: "scatter3d",
      mode: "lines",
      x: leaseXKm,
      y: leaseYKm,
      z: leaseZKm,
      line: {
        color: "red",
        width: 8
      },
      name: "Lease Boundary",
      hovertemplate:
        "Lease Boundary<br>" +
        "X: %{x:.2f} km<br>" +
        "Y: %{y:.2f} km<extra></extra>"
    };

    const layout = {
      title: {
        text: `GEBCO 2025 3D Bathymetry Relief - Vertical Exaggeration x${verticalExaggeration}`,
        font: { color: "white", size: 16 }
      },

      paper_bgcolor: "black",
      plot_bgcolor: "black",
      font: { color: "white" },

      margin: {
        l: 0,
        r: 0,
        t: 50,
        b: 0
      },

      scene: {
        xaxis: {
          title: "East-West Distance (km)",
          backgroundcolor: "black",
          gridcolor: "#444",
          zerolinecolor: "#666",
          color: "white"
        },

        yaxis: {
          title: "North-South Distance (km)",
          backgroundcolor: "black",
          gridcolor: "#444",
          zerolinecolor: "#666",
          color: "white"
        },

        zaxis: {
          title: `Elevation x${verticalExaggeration} (km)`,
          backgroundcolor: "black",
          gridcolor: "#444",
          zerolinecolor: "#666",
          color: "white"
        },

        aspectmode: "manual",
        aspectratio: {
          x: 1.4,
          y: 1.0,
          z: 0.45
        },

        camera: {
          eye: {
            x: 1.55,
            y: -1.65,
            z: 0.85
          },
          center: {
            x: 0,
            y: 0,
            z: -0.15
          }
        }
      },

      legend: {
        bgcolor: "rgba(0,0,0,0.5)",
        font: { color: "white" }
      }
    };

    Plotly.newPlot("map", [surface, leaseBoundary3D], layout, {
      responsive: true,
      displaylogo: false,
      scrollZoom: true
    });
  }
</script>

    loadData();
  </script>

</body>
</html>